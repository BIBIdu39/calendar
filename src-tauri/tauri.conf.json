{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Calendar",
  "version": "0.1.0",
  "identifier": "fr.calendar.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Calendar",
        "width": 1080,
        "height": 780,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCQTk3MDEyMDQ3NzlFN0IKUldSN25uY0VFbkNwUzRrVTZlOG9HU1VoNEZlM3p5SzhlQWpJVWhaRVVUZnRJRU9JYkVnR0s3cjAK",
      "endpoints": [
        "https://github.com/BIBIdu39/calendar/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
